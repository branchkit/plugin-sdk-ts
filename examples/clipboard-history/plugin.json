{
  "id": "clipboard-history",
  "name": "Clipboard History",
  "version": "0.1.0",
  "description": "Track and recall clipboard entries via voice commands.",
  "run": "bun run ./index.ts",
  "action_prefix": "clipboard",
  "implements": {
    "on_action": true,
    "render_settings": true,
    "settings_tabs": [{ "label": "History", "key": "history" }]
  },
  "subscribes_to": [
    { "pattern": "_platform.app.focused" }
  ]
}
