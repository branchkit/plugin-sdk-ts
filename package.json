{
  "name": "@branchkit/plugin-sdk-ts",
  "version": "0.1.0",
  "description": "TypeScript SDK for building BranchKit plugins",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./harness": {
      "bun": "./src/harness.ts",
      "import": "./dist/harness.js",
      "types": "./dist/harness.d.ts"
    },
    "./stage": {
      "bun": "./src/stage.ts",
      "import": "./dist/stage.js",
      "types": "./dist/stage.d.ts"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/__tests__",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "keywords": [
    "branchkit",
    "plugin",
    "sdk",
    "voice",
    "macos"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/branchkit/plugin-sdk-ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22",
    "typescript": "^5.7"
  }
}
